# ==============================================================================
# .gitignore for Strategic Dashboard
# ==============================================================================

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
.env/

# OS files
.DS_Store
Thumbs.db

# Large models
*.pkl
*.joblib
*.npy
*.pth
*.onnx
*.pb
*.h5

# Omission of non-executable folders (User Request)
.claude/
.github/
explorations/
guide/
master_supporting_docs/
paper/
quality_reports/
templates/

# Omission of non-essential files (User Request)
CHANGELOG.md
CLAUDE.md
dashboard.md
MEMORY.md
